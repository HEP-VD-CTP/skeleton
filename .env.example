# ──────────────────────────────────────────────
# Environment
# ──────────────────────────────────────────────
# Must be either "development" or "production"
ENV=development

# Timezone used by all containers
TZ=Europe/Zurich

# ──────────────────────────────────────────────
# Application
# ──────────────────────────────────────────────
# Organization name displayed in the app
ORGANIZATION=ORG-NAME

# Browser tab title
FRONTEND_TITLE=skeleton

# Public domain (include port if non-standard)
DOMAIN=localhost:8443

# ──────────────────────────────────────────────
# Volumes
# ──────────────────────────────────────────────
# Host path for persistent data (logs, files, databases)
# Change this to match your local environment
VOLUME_PATH=/Users/user/volumes/skeleton

# ──────────────────────────────────────────────
# Nginx
# ──────────────────────────────────────────────
# SSL certificate and key paths
# Default: self-signed certs in ./packages/nginx
# Replace with your own certificates for production
NGINX_CERTIFICATE_LOCATION=./packages/nginx/nginx.crt
NGINX_CERTIFICATE_KEY_LOCATION=./packages/nginx/nginx.key

# HTTPS port exposed on the host
NGINX_HTTPS_PORT=8443

# ──────────────────────────────────────────────
# Authentication
# ──────────────────────────────────────────────
# User session expiration in seconds (default: 1 day)
USER_SESSION_EXP=86400

# ──────────────────────────────────────────────
# PostgreSQL
# ──────────────────────────────────────────────
# Port exposed on the host (for external access / dev tools)
POSTGRES_EXTERNAL_PORT=5432

# Database credentials
POSTGRES_USER=postgres
POSTGRES_DB=skeleton
POSTGRES_PASSWORD=123456

# ──────────────────────────────────────────────
# Redis
# ──────────────────────────────────────────────
# Port exposed on the host (for external access / dev tools)
REDIS_EXTERNAL_PORT=6379
